<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- FXML layout for the Smart Board tab -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.yourorg.classroom.gui.SmartBoardController"
      alignment="TOP_CENTER"
      spacing="10">
  
  <!-- Title label -->
  <Label text="Smart Board Control"
         style="-fx-font-size: 18px; -fx-font-weight: bold;"
         padding="10"/>

  <!-- Text area that displays current SmartBoard content -->
  <TextArea fx:id="boardDisplayArea"
            prefHeight="300" prefWidth="600"
            promptText="Smart Board content will appear here..." />

  <!-- Button to submit updated content to the SmartBoardService -->
  <HBox alignment="CENTER" spacing="10" padding="10">
    <Button text="Update SmartBoard"
            onAction="#handleUpdateButtonAction" />
  </HBox>
</VBox>
