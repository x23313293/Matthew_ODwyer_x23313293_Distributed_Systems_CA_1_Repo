<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.yourorg.classroom</groupId>
    <artifactId>classroom-simulation</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>SmartBoardService</artifactId>
  <packaging>jar</packaging>
  <name>Smart Board gRPC Service</name>

  <properties>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
  </properties>

  <dependencies>
    <!-- brings in generated gRPC stubs -->
    <dependency>
      <groupId>com.yourorg.classroom</groupId>
      <artifactId>proto</artifactId>
    </dependency>

    <!-- for service discovery -->
    <dependency>
      <groupId>com.yourorg.classroom</groupId>
      <artifactId>discovery</artifactId>
    </dependency>

    <!-- gRPC runtime (stub; protobuf; Netty) -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- allows mvn exec:java to start your server app-->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <id>run-smartboard</id>
            <goals><goal>java</goal></goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>com.yourorg.classroom.smartboard.SmartBoardServer</mainClass>
          <!-- optional: classpathScope, args, etc. -->
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
